# 回声·往宠 H5 环境变量示例。复制为 .env.local 后按需修改。

# 真后端 Base URL。留空 = 走本地 mock（localStorage 持久化），前端可独立跑通与部署。
# 填写后前端请求 `${VITE_API_BASE}/api/v1/...`，携带 Authorization: Bearer <游客 token>。
# 例：VITE_API_BASE=https://api.echo.example.com
VITE_API_BASE=

# 静态部署子路径（OSS/COS 子目录）。默认 "/"；子路径部署示例：VITE_BASE=/echo/
VITE_BASE=/

# 可选：埋点上报端点（留空则只在 console 打印，不上报）。
VITE_TRACK_ENDPOINT=

# 内部测试数据总闸。默认开（原型/联调期要有内容可看）。
# 置 0 = 一次性摘掉全部测试账号与种子内容（共鸣厅/搜索/亲友/消息一并清空，官方号「回声整理室」保留）。
# 口径与清理步骤见 src/data/testData.ts。
VITE_SHOW_TEST_DATA=1

# C1「留一句话」在 **mock 后端**里下发的开关值（DECISIONS S13）。默认 0 = 关闭，与 P0 口径一致。
# 置 1 只是让假后端把 featureFlags().leaveMessage 下发成 true，方便本地看一眼这套 UI。
#
# 它不是前端本地开关：组件只认 api.featureFlags() 的返回值，没有任何组件读得到这个变量；
# VITE_API_BASE 非空（接真后端）时这段 mock 代码根本不执行，开关完全由服务端说了算。
#
# ⚠️ 真正上线开启的前置条件在 S13 ②：文本安全闸 + S3 五项治理能力（拉黑 / 举报 / 关互动 /
# 审核队列 / 文本安全闸）全部就绪，且开关变更纳入 SPEC-admin-console §4.7 ② 的二次审批。
VITE_MOCK_LEAVE_MESSAGE=0

# ===== 静态物料（不入代码库，见 docs/ASSETS.md）=====

# 资源根的绝对路径。开发/预览期由 Vite 中间件把 /assets/** 映射到 <此目录>/static/。
# 留空 = 取仓库同级的 ../../Echo-assets，按 workSpace/Echo + workSpace/Echo-assets 并排放即可。
ECHO_ASSETS_DIR=

# 生产物料前缀，指向 CDN/OSS 上对应 static/ 的目录（构建期注入，末尾不带斜杠）。
# 留空 = 走开发中间件读本地磁盘。例：VITE_ASSET_BASE_URL=https://cdn.echo.example.com/static
VITE_ASSET_BASE_URL=
